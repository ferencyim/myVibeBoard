# Connected host with a selected model, 1600x2560 at density 320. See README.md.
# FORM_URL=paseo://new?serverId=<serverId>; MODEL_ID names a real catalog model that offers effort
# levels (so the picker stays open after the pick); TRIGGER_LABEL is the trigger's full label after
# the pick, "模型：<model label> · <effort label>".
context platform=android timeout=60000 retries=0
env APP_ID=sh.paseo.debug
env PROVIDER_ID=codex

open "${APP_ID}" "${FORM_URL}"
wait "label=\"Workspace project\"" 20000
press "id=\"combined-model-selector\""
wait "id=\"provider-model-picker-popover\"" 10000
press "id=\"provider-model-picker-tab-${PROVIDER_ID}\""
wait "id=\"provider-model-picker-row-${MODEL_ID}\"" 3000
press "id=\"provider-model-picker-row-${MODEL_ID}\""
wait "id=\"provider-model-picker-effort\"" 3000
# Android Back dismisses the whole popover and keeps the new selection.
back
wait "id=\"combined-model-selector\" label=\"${TRIGGER_LABEL}\"" 3000

# A drag that leaves the short viewport must scroll without selecting or dismissing.
press "id=\"combined-model-selector\""
wait "id=\"provider-model-picker-row-${MODEL_ID}\"" 3000
gesture pan 1000 1850 0 -700 600
wait "id=\"provider-model-picker-row-${LAST_MODEL_ID}\"" 3000
gesture fling down 1000 1750 500
wait "id=\"provider-model-picker-row-${MODEL_ID}\"" 3000
# Android Back dismisses the whole popover without changing the selection.
back
wait "id=\"combined-model-selector\" label=\"${TRIGGER_LABEL}\"" 3000
close
