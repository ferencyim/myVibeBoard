# Idle existing agent in a narrow composer on a wide Android device (AdaptiveModalSheet).
# AGENT_URL=paseo://h/<serverId>/agent/<agentId>; AGENT_TITLE identifies the loaded route.
# MODEL_ID offers effort levels; TRIGGER_LABEL is "模型：<model label> · <effort label>".
context platform=android timeout=60000 retries=0
env APP_ID=sh.paseo.debug
env PROVIDER_ID=codex

open "${APP_ID}" "${AGENT_URL}"
wait "label=\"${AGENT_TITLE}\"" 20000
wait "id=\"combined-model-selector\"" 10000
press "id=\"combined-model-selector\""
wait "id=\"provider-model-picker-tab-${PROVIDER_ID}\"" 10000
press "id=\"provider-model-picker-tab-${PROVIDER_ID}\""
wait "id=\"provider-model-picker-row-${MODEL_ID}\"" 3000
press "id=\"provider-model-picker-row-${MODEL_ID}\""
wait "id=\"provider-model-picker-effort\"" 3000
back
wait "id=\"combined-model-selector\" label=\"${TRIGGER_LABEL}\"" 3000

press "id=\"combined-model-selector\""
wait "id=\"provider-model-picker-row-${MODEL_ID}\"" 3000
back
wait "id=\"combined-model-selector\" label=\"${TRIGGER_LABEL}\"" 3000
close
