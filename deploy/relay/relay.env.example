# Copy to relay.env (git-ignored, local only) and fill in. Never commit real values.
# Used by install.sh / uninstall.sh (--env-file) and by docker-compose.yml.

# --- required ---------------------------------------------------------------
# Public domain the phone/daemon connect to (DNS must already point at this host).
RELAY_DOMAIN=relay.example.com
# Host loopback port the relay container is published on (127.0.0.1 only).
RELAY_PORT=14000   # pick a free port: ss -ltn
# Fixed git ref of getpaseo/paseo-relay to build. The repo has NO tags/releases (checked 2026-10-19), so pin a
# full commit SHA; 3fc41c96c8c63f3a7109e832899cc57d473c4531 was main on 2026-08-22 (re-check before deploying).
RELAY_REF=<PINNED_TAG_OR_SHA>
# Existing certificate chain and private key (e.g. a wildcard cert other sites already use). Read-only: the
# scripts only reference these paths in the new nginx site; they never issue, copy or modify them.
TLS_CERT=/etc/ssl/vibe-relay/fullchain.pem
TLS_KEY=/etc/ssl/vibe-relay/privkey.pem

# --- optional ---------------------------------------------------------------
# File name of the one new nginx site file (created in NGINX_CONF_DIR). Existing files are never touched.
NGINX_SITE_NAME=vibe-relay.conf
NGINX_CONF_DIR=/etc/nginx/conf.d
# Port the relay listens on INSIDE the container (verified: its Dockerfile sets PASEO_RELAY_PORT=4000).
RELAY_CONTAINER_PORT=4000
# paseo-relay needs NO secrets or required env vars. Memory watermark (bytes) makes it shed sockets under
# pressure instead of being OOM-killed; ~70% of RELAY_MEM_LIMIT is sensible (512m -> 360000000). 0 = off.
RELAY_MEMORY_WATERMARK_BYTES=360000000
# Compose project name (also names the network) and resource limits.
RELAY_PROJECT=vibe-relay
RELAY_MEM_LIMIT=512m
RELAY_CPUS=1.0
RELAY_PIDS_LIMIT=256
# Push gateway (services/vibe-push-gateway, WP-44; its own default 8787 is often taken, so use another port, e.g. 18787)
# runs as a second compose service (profile "push") of the same project, published on 127.0.0.1:<PUSH_PORT> only.
# When set: the gateway is built from ../../services/vibe-push-gateway (copy it next to deploy/), a random
# VIBE_PUSH_AUTH_TOKEN is generated into PUSH_ENV_FILE, and the site proxies https://<RELAY_DOMAIN>/push/ to it
# (prefix stripped). Without a FCM service account the gateway runs dry-run. Empty = no gateway, no push location.
PUSH_PORT=18787
PUSH_ENV_FILE=/var/lib/vibe-relay/push-gateway.env
# Where install state (manifest, nginx -T summary backup) is kept.
STATE_DIR=/var/lib/vibe-relay
